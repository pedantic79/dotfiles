#!/usr/bin/env bash

set -o errexit
set -o pipefail
set -o errtrace

NORMAL=""
RED=""
YELLOW=""
GREEN=""
CMD_COLOR=""
ORANGE=""

if [[ -t 1 && -z "${NO_COLOR+x}" && -n "${TERM:-}" ]] &&
	command -v tput >/dev/null 2>&1; then
	if NORMAL=$(tput sgr0 2>/dev/null) &&
		RED=$(tput setaf 1 2>/dev/null) &&
		YELLOW=$(tput setaf 220 2>/dev/null) &&
		GREEN=$(tput setaf 34 2>/dev/null) &&
		CMD_COLOR=$(tput setaf 199 2>/dev/null) &&
		ORANGE=$(tput setaf 208 2>/dev/null); then
		:
	else
		NORMAL=""
		RED=""
		YELLOW=""
		GREEN=""
		CMD_COLOR=""
		ORANGE=""
	fi
fi

PROMPT="${ORANGE}»"

declare -r NORMAL RED YELLOW GREEN CMD_COLOR ORANGE PROMPT

err_report() {
	echo "${RED}Error running '$1' [rc=$2] line ${3}${NORMAL}"
}

trap 'err_report "$BASH_COMMAND" $? $LINENO' ERR

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	echo "$(basename "$PWD") isn't a git project."
	exit 1
fi

if ! original_branch="$(git symbolic-ref --quiet --short HEAD)"; then
	echo "${RED}git-up requires a checked-out branch; HEAD is detached... abort${NORMAL}" >&2
	exit 1
fi

resolve_default_branch() {
	local remote_name="$1"
	local ref=""

	ref=$(git ls-remote --symref "$remote_name" HEAD 2>/dev/null |
		awk '$1 == "ref:" { print $2; exit }')
	if [[ "$ref" == refs/heads/* ]]; then
		echo "${ref#refs/heads/}"
		return
	fi

	echo "${RED}default branch for remote '$remote_name' is not found... abort${NORMAL}" >&2
	return 1
}

# readarray doesn't work in MacOS
declare -a remotes
while read -r line; do
	remotes+=("$line")
done < <(git remote)

message="missing"
remote=""

for i in "${remotes[@]}"; do
	if [ "$i" = "origin" ]; then
		message="${YELLOW}upstream missing using origin${NORMAL}"
		remote="origin"
		break
	fi
done

for i in "${remotes[@]}"; do
	if [ "$i" = "upstream" ]; then
		remote="upstream"
		message="${YELLOW}Detected ${remote}${NORMAL}"
		break
	fi
done

if [ -z "$remote" ]; then
	echo "${RED}origin branch is not found... abort${NORMAL}"
	exit 1
fi

printf "%-60s" "$message"
echo "${PROMPT}${CMD_COLOR} git fetch --all --tags --prune --force${NORMAL}"
git fetch --all --tags --prune --force
if ! default_branch=$(resolve_default_branch "$remote"); then
	exit 1
fi

if ! git show-ref --verify --quiet "refs/heads/$default_branch"; then
	echo "${RED}local branch '$default_branch' is not found... abort${NORMAL}" >&2
	exit 1
fi

if ! git show-ref --verify --quiet "refs/remotes/$remote/$default_branch"; then
	echo "${RED}$remote/$default_branch is not found after fetch... abort${NORMAL}" >&2
	exit 1
fi

remote_default=$(git rev-parse --short "$remote/$default_branch")
local_default=$(git rev-parse --short "$default_branch")

if [ "$remote_default" = "$local_default" ]; then
	echo "${GREEN}$remote/$default_branch and $default_branch are on the same commit: ${local_default}${NORMAL}"
	exit 0
fi

# missing upstream
printf "%-60s" "${YELLOW}rebasing $remote/$default_branch to $default_branch${NORMAL}"
echo "${PROMPT}${CMD_COLOR} git rebase $remote/$default_branch $default_branch${NORMAL}"
git rebase "$remote/$default_branch" "$default_branch"

push_status=0
if [ "$remote" = "upstream" ]; then
	printf "%-60s" "${YELLOW}pushing to origin/$default_branch${NORMAL}"
	echo "${PROMPT}${CMD_COLOR} git push origin $default_branch${NORMAL}"
	if git push origin "$default_branch"; then
		:
	else
		push_status=$?
	fi
fi

restore_status=0
current_branch="$(git symbolic-ref --short HEAD)"
if [ "$current_branch" != "$original_branch" ]; then
	printf "%-60s" "${YELLOW}switching to $original_branch${NORMAL}"
	echo "${PROMPT}${CMD_COLOR} git checkout $original_branch${NORMAL}"
	if git checkout "$original_branch"; then
		:
	else
		restore_status=$?
		echo "${RED}Failed to restore $original_branch [rc=$restore_status]${NORMAL}" >&2
	fi
fi

if [ "$restore_status" -ne 0 ]; then
	if [ "$push_status" -ne 0 ]; then
		echo "${RED}Push also failed [rc=$push_status]${NORMAL}" >&2
	fi
	exit "$restore_status"
fi

if [ "$push_status" -ne 0 ]; then
	exit "$push_status"
fi
