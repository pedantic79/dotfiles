#!/usr/bin/env bash

set -o errexit
set -o pipefail

NORMAL=""
RED=""
YELLOW=""
GREEN=""
CMD_COLOR=""
ORANGE=""

init_colors() {
	[[ -t 1 && -z "${NO_COLOR+x}" && -n "${TERM:-}" ]] || return 0
	command -v tput >/dev/null 2>&1 || return 0

	local normal red yellow green command_color orange
	if normal=$(tput sgr0 2>/dev/null) &&
		red=$(tput setaf 1 2>/dev/null) &&
		yellow=$(tput setaf 220 2>/dev/null) &&
		green=$(tput setaf 34 2>/dev/null) &&
		command_color=$(tput setaf 199 2>/dev/null) &&
		orange=$(tput setaf 208 2>/dev/null); then
		NORMAL="$normal"
		RED="$red"
		YELLOW="$yellow"
		GREEN="$green"
		CMD_COLOR="$command_color"
		ORANGE="$orange"
	fi
}

init_colors

PROMPT="${ORANGE}»"

declare -r NORMAL RED YELLOW GREEN CMD_COLOR ORANGE PROMPT

run_step() {
	local message="$1"
	shift
	local command status
	local line="${BASH_LINENO[0]}"
	printf -v command '%q ' "$@"
	command="${command% }"

	printf "%-60s" "$message"
	printf '%s %s%s\n' "${PROMPT}${CMD_COLOR}" "$command" "$NORMAL"

	if "$@"; then
		return 0
	else
		status=$?
	fi

	echo "${RED}Error running '$command' [rc=$status] line ${line}${NORMAL}"
	return "$status"
}

if ! original_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
	if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		echo "${RED}git-up requires a checked-out branch; HEAD is detached... abort${NORMAL}" >&2
	else
		echo "$(basename "$PWD") isn't a git project."
	fi
	exit 1
fi

resolve_default_branch() {
	local remote_name="$1"
	local ref=""

	ref=$(git ls-remote --symref "$remote_name" HEAD 2>/dev/null |
		awk '$1 == "ref:" { print $2; exit }')
	if [[ "$ref" == refs/heads/* ]]; then
		echo "${ref#refs/heads/}"
		return
	fi

	echo "${RED}default branch for remote '$remote_name' is not found... abort${NORMAL}" >&2
	return 1
}

has_origin=false
has_upstream=false
while read -r remote_name; do
	case "$remote_name" in
	origin) has_origin=true ;;
	upstream) has_upstream=true ;;
	esac
done < <(git remote)

publish_remote=""
if $has_upstream && $has_origin; then
	source_remote="upstream"
	publish_remote="origin"
	fetch_message="${YELLOW}Detected $source_remote${NORMAL}"
elif $has_upstream; then
	echo "${RED}publish remote 'origin' is not found... abort${NORMAL}" >&2
	exit 1
elif $has_origin; then
	source_remote="origin"
	fetch_message="${YELLOW}upstream missing using $source_remote${NORMAL}"
else
	echo "${RED}origin or upstream remote is not found... abort${NORMAL}"
	exit 1
fi

declare -r source_remote publish_remote fetch_message

run_step "$fetch_message" git fetch --all --tags --prune --force
if ! default_branch=$(resolve_default_branch "$source_remote"); then
	exit 1
fi

local_default=""
remote_default=""
while read -r ref_name commit; do
	case "$ref_name" in
	"refs/heads/$default_branch") local_default="$commit" ;;
	"refs/remotes/$source_remote/$default_branch") remote_default="$commit" ;;
	esac
done < <(
	git for-each-ref --format='%(refname) %(objectname:short)' \
		"refs/heads/$default_branch" \
		"refs/remotes/$source_remote/$default_branch"
)

if [ -z "$local_default" ]; then
	echo "${RED}local branch '$default_branch' is not found... abort${NORMAL}" >&2
	exit 1
fi

if [ -z "$remote_default" ]; then
	echo "${RED}$source_remote/$default_branch is not found after fetch... abort${NORMAL}" >&2
	exit 1
fi

if [ "$remote_default" = "$local_default" ]; then
	echo "${GREEN}$source_remote/$default_branch and $default_branch are on the same commit: ${local_default}${NORMAL}"
	exit 0
fi

run_step "${YELLOW}rebasing $source_remote/$default_branch to $default_branch${NORMAL}" \
	git rebase "$source_remote/$default_branch" "$default_branch"

if [ "$original_branch" != "$default_branch" ]; then
	run_step "${YELLOW}switching to $original_branch${NORMAL}" \
		git checkout "$original_branch"
fi

if [ -n "$publish_remote" ]; then
	run_step "${YELLOW}pushing to $publish_remote/$default_branch${NORMAL}" \
		git push "$publish_remote" "$default_branch"
fi
